funcv x87_fldpi_void $

macro FLDPI_VOID
    call x87_fldpi_void $
endm

funcv x87_fxam_void $
funcv x87_fprem_void $
funcv x87_fscale_void $
funcv x87_fpatan_void $

macro FXAM_VOID
    call x87_fxam_void $
endm

macro FPREM_VOID
    call x87_fprem_void $
endm

macro FSCALE_VOID
    call x87_fscale_void $
endm

macro FPATAN_VOID
    call x87_fpatan_void $
endm

funcv x87_fnstenv_void $, *env
funcv x87_fldenv_void $, *env

macro FNSTENV_MEM env
    call x87_fnstenv_void $, \env
endm

macro FLDENV_MEM env
    call x87_fldenv_void $, \env
endm

funcv x87_frndint_void $
funcv x87_f2xm1_void $

macro FRNDINT_VOID
    call x87_frndint_void $
endm

macro F2XM1_VOID
    call x87_f2xm1_void $
endm

; repe/repne cmpsd (llasm_cmps.c): set ecx, esi, edi and the flags
funcv x86_repe_cmpsd $
funcv x86_repne_cmpsd $

macro REPE_CMPSD
    call x86_repe_cmpsd $
endm

macro REPNE_CMPSD
    call x86_repne_cmpsd $
endm

; x87 instructions that the SR support files do not have (cpu-extra.c)
funcv x87_fsincos_void $
funcv x87_fldl2e_void $
funcv x87_fcomip_st $, num
funcv x87_fucomip_st $, num
funcv x86_cpuid $
funcv x86_rdtsc $

macro FSINCOS_VOID
    call x87_fsincos_void $
endm

macro FLDL2E_VOID
    call x87_fldl2e_void $
endm

; ffree st(i): the register is only tagged empty, the stack top does not
; change. There are no tags here, so it does nothing.
macro FFREE_ST num
endm

macro FCOMIP_ST num
    call x87_fcomip_st $, \num
endm

macro FUCOMIP_ST num
    call x87_fucomip_st $, \num
endm

; "lock bts dword [addr], 0": returns the old bit 0 in tmp0 (atomic)
func x86_lock_bts0 *addr

; Generals Zero Hour (games/command-and-conquer-generals-zero-hour/native-mac/runtime/llasm/xfer-unicode.c):
; read the characters of a save-file Unicode string of either width; 1 in tmp0 when done
func generals_xfer_read_unicode self, *buffer, size
