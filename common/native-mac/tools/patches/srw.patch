+/* Imported functions that never return: the code after a call to one of
+   them is not reached (it can be padding or data). */
+int SR_is_noret_import(const char *proc)
+{
+    static const char *const names[] = {
+        "_CxxThrowException", "exit", "_exit", "abort", "longjmp", "_amsg_exit",
+        "ExitProcess", "ExitThread", "_endthread", "_endthreadex",
+        "FatalAppExitA", "FatalExit", NULL
+    };
+    int i;
+
+    if (proc == NULL) return 0;
+    for (i = 0; names[i] != NULL; i++)
+    {
+        if (strcmp(proc, names[i]) == 0) return 1;
+    }
+    return 0;
+}
