;; Commandos port: llasm procedures called from C.
;; MIT license, see README.md.

include llasm.llinc
include asm-calls.llinc

proc CallFunction_c2asm global c_CallFunction_c2asm

; [esp + 2*4] = first argument of the x86 function
; [esp +   4] = address of the x86 function
; [esp      ] = return address

        load tmp0, esp, 4
        add tmp1, esp, 4
        load tmp1, tmp1, 4
        add esp, esp, 4
        store tmp0, esp, 4
        tcall tmp1

endp ; end procedure CallFunction_c2asm


; C runtime math functions that the game calls (see srw/llasm/external_procedures.sci)
; FACOS_VOID, FASIN_VOID, FLOG10_VOID and FLOOR_DOUBLE come from llasm_float.llinc.

funcv x87_fatan_void $
funcv x87_fld_ceil $, low, high

proc _CIacos_asm2c public
; st0 = num, [esp] = return address
        FACOS_VOID
        Call_Asm_Return 0
endp

proc _CIasin_asm2c public
        FASIN_VOID
        Call_Asm_Return 0
endp

proc _CIatan_asm2c public
        call x87_fatan_void $
        Call_Asm_Return 0
endp

proc _CIlog10_asm2c public
        FLOG10_VOID
        Call_Asm_Return 0
endp

proc floor_asm2c public
; [esp + 2*4] = high dword of the double, [esp + 4] = low dword (cdecl)
        add tmp0, esp, 4
        load tmp0, tmp0, 4
        add tmp1, esp, 2*4
        load tmp1, tmp1, 4
        FLOOR_DOUBLE tmp0, tmp1
        Call_Asm_Return 0
endp

proc ceil_asm2c public
        add tmp0, esp, 4
        load tmp0, tmp0, 4
        add tmp1, esp, 2*4
        load tmp1, tmp1, 4
        call x87_fld_ceil $, tmp0, tmp1
        Call_Asm_Return 0
endp

proc IsNonwritableInCurrentImage_asm2c public
; CRT _IsNonwritableInCurrentImage(pTarget), cdecl. The recompiled image has
; no PE header at 0x400000, so the CRT check always fails. The pointers it
; checks (_FPinit, initializer tables) are all in read-only data: return TRUE.
        mov eax, 1
        Call_Asm_Return 0
endp

proc CrtNotMixedImage_asm2c public
; CRT helper (no arguments) used by _encode_pointer/_decode_pointer. On
; Windows XP it reads the PE header at 0x400000 and looks for a ".mixcrt"
; section. Guest address 0x400000 is not the image here. Return 1, as the
; function does on Windows Vista and later and for images without .mixcrt.
        mov eax, 1
        Call_Asm_Return 0
endp

func cfltcvt_c *arg, *buffer, size, format, precision, caps

proc cfltcvt_asm2c public
; CRT _cfltcvt_l(double *arg, char *buffer, size_t size, int format,
;                int precision, int caps, _locale_t locale), cdecl.
; The CRT version converts through 80-bit x87 code that the recompiled
; 64-bit x87 does not give correctly. cfltcvt_c is a native version.
        add tmp0, esp, 4
        load tmp0, tmp0, 4
        add tmp1, esp, 2*4
        load tmp1, tmp1, 4
        add tmp2, esp, 3*4
        load tmp2, tmp2, 4
        add tmp3, esp, 4*4
        load tmp3, tmp3, 4
        add tmp4, esp, 5*4
        load tmp4, tmp4, 4
        add tmp5, esp, 6*4
        load tmp5, tmp5, 4
        call cfltcvt_c tmp0, tmp1, tmp2, tmp3, tmp4, tmp5
        mov eax, tmp0
        Call_Asm_Return 0
endp

