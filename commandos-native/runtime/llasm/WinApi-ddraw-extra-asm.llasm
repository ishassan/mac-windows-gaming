;; Commandos port: COM glue for IDirectDrawPalette and IDirectDrawClipper.
;; Same pattern as WinApi-ddraw-asm.llasm (M-HT/SR, MIT license).

include llasm.llinc
include asm-calls.llinc

func IDirectDrawPalette_QueryInterface_c *lpThis, *riid, *ppvObj
func IDirectDrawPalette_AddRef_c *lpThis
func IDirectDrawPalette_Release_c *lpThis
func IDirectDrawPalette_GetCaps_c *lpThis, *lpdwCaps
func IDirectDrawPalette_GetEntries_c *lpThis, dwFlags, dwBase, dwNumEntries, *lpEntries
func IDirectDrawPalette_Initialize_c *lpThis, *lpDD, dwFlags, *lpDDColorTable
func IDirectDrawPalette_SetEntries_c *lpThis, dwFlags, dwStartingEntry, dwCount, *lpEntries

func IDirectDrawClipper_QueryInterface_c *lpThis, *riid, *ppvObj
func IDirectDrawClipper_AddRef_c *lpThis
func IDirectDrawClipper_Release_c *lpThis
func IDirectDrawClipper_GetClipList_c *lpThis, *lpRect, *lpClipList, *lpdwSize
func IDirectDrawClipper_GetHWnd_c *lpThis, *lphWnd
func IDirectDrawClipper_Initialize_c *lpThis, *lpDD, dwFlags
func IDirectDrawClipper_IsClipListChanged_c *lpThis, *lpbChanged
func IDirectDrawClipper_SetClipList_c *lpThis, *lpClipList, dwFlags
func IDirectDrawClipper_SetHWnd_c *lpThis, dwFlags, hWnd

proc IDirectDrawPalette_QueryInterface_asm2c public
        Call_Asm_Stack3 IDirectDrawPalette_QueryInterface_c
        Call_Asm_Return 3
endp
proc IDirectDrawPalette_AddRef_asm2c public
        Call_Asm_Stack1 IDirectDrawPalette_AddRef_c
        Call_Asm_Return 1
endp
proc IDirectDrawPalette_Release_asm2c public
        Call_Asm_Stack1 IDirectDrawPalette_Release_c
        Call_Asm_Return 1
endp
proc IDirectDrawPalette_GetCaps_asm2c public
        Call_Asm_Stack2 IDirectDrawPalette_GetCaps_c
        Call_Asm_Return 2
endp
proc IDirectDrawPalette_GetEntries_asm2c public
        Call_Asm_Stack5 IDirectDrawPalette_GetEntries_c
        Call_Asm_Return 5
endp
proc IDirectDrawPalette_Initialize_asm2c public
        Call_Asm_Stack4 IDirectDrawPalette_Initialize_c
        Call_Asm_Return 4
endp
proc IDirectDrawPalette_SetEntries_asm2c public
        Call_Asm_Stack5 IDirectDrawPalette_SetEntries_c
        Call_Asm_Return 5
endp

proc IDirectDrawClipper_QueryInterface_asm2c public
        Call_Asm_Stack3 IDirectDrawClipper_QueryInterface_c
        Call_Asm_Return 3
endp
proc IDirectDrawClipper_AddRef_asm2c public
        Call_Asm_Stack1 IDirectDrawClipper_AddRef_c
        Call_Asm_Return 1
endp
proc IDirectDrawClipper_Release_asm2c public
        Call_Asm_Stack1 IDirectDrawClipper_Release_c
        Call_Asm_Return 1
endp
proc IDirectDrawClipper_GetClipList_asm2c public
        Call_Asm_Stack4 IDirectDrawClipper_GetClipList_c
        Call_Asm_Return 4
endp
proc IDirectDrawClipper_GetHWnd_asm2c public
        Call_Asm_Stack2 IDirectDrawClipper_GetHWnd_c
        Call_Asm_Return 2
endp
proc IDirectDrawClipper_Initialize_asm2c public
        Call_Asm_Stack3 IDirectDrawClipper_Initialize_c
        Call_Asm_Return 3
endp
proc IDirectDrawClipper_IsClipListChanged_asm2c public
        Call_Asm_Stack2 IDirectDrawClipper_IsClipListChanged_c
        Call_Asm_Return 2
endp
proc IDirectDrawClipper_SetClipList_asm2c public
        Call_Asm_Stack3 IDirectDrawClipper_SetClipList_c
        Call_Asm_Return 3
endp
proc IDirectDrawClipper_SetHWnd_asm2c public
        Call_Asm_Stack3 IDirectDrawClipper_SetHWnd_c
        Call_Asm_Return 3
endp

datasegment ddraw_extra_data constant

dlabel IDirectDrawPaletteVtbl_asm2c global
daddr IDirectDrawPalette_QueryInterface_asm2c
daddr IDirectDrawPalette_AddRef_asm2c
daddr IDirectDrawPalette_Release_asm2c
daddr IDirectDrawPalette_GetCaps_asm2c
daddr IDirectDrawPalette_GetEntries_asm2c
daddr IDirectDrawPalette_Initialize_asm2c
daddr IDirectDrawPalette_SetEntries_asm2c

dlabel IDirectDrawClipperVtbl_asm2c global
daddr IDirectDrawClipper_QueryInterface_asm2c
daddr IDirectDrawClipper_AddRef_asm2c
daddr IDirectDrawClipper_Release_asm2c
daddr IDirectDrawClipper_GetClipList_asm2c
daddr IDirectDrawClipper_GetHWnd_asm2c
daddr IDirectDrawClipper_Initialize_asm2c
daddr IDirectDrawClipper_IsClipListChanged_asm2c
daddr IDirectDrawClipper_SetClipList_asm2c
daddr IDirectDrawClipper_SetHWnd_asm2c

endd
